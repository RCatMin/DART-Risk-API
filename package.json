{
  "name": "dart-risk-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node --env-file=.env dist/index.js",
    "seed:watchlist": "tsc && node --env-file=.env dist/scripts/seed-watchlist.js",
    "workers": "tsc && node --env-file=.env dist/queue/run-workers.js",
    "enqueue:collect": "tsc && node --env-file=.env dist/scripts/enqueue-collect.js",
    "enqueue:test-failure": "tsc && node --env-file=.env dist/scripts/enqueue-test-failure.js",
    "loadtest": "set -a && . ./.env && set +a && k6 run -e API_KEY=\"$API_KEY\" -e BASE_URL=\"http://localhost:${PORT:-3000}\" -e CORP_CODE=00126380 k6/load-test.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.2.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  }
