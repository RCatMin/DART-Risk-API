# DART 공시 API 키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 공공데이터포털 "금융위원회_주식시세정보" 서비스키 (https://www.data.go.kr/data/15094808/openapi.do 에서 활용신청)
PUBLIC_DATA_API_KEY=

# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Redis 연결 문자열 (BullMQ, API 캐시에서 사용)
REDIS_URL="redis://localhost:6379"

# 조회 API 인증용 키 (직접 발급 — openssl rand -hex 24)
API_KEY=

# API 서버 포트
PORT=3000

# production일 때만 로그가 JSON으로 출력됨 (그 외엔 pino-pretty로 보기 좋게 출력)
NODE_ENV=development
